  "license": "Apache-2.0",
  "author": "Jānis Strautiņš (https://janisstrautins.lv)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strauteka/bin-packing.git",
    "directory": "packages/space-utilization"
  },
  "bugs": "https://github.com/Strauteka/bin-packing/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
