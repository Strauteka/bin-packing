{
  "name": "@strauteka/bin-packing",
  "version": "0.1.0",
  "description": "3D bin packing for container loading: an empty-space distribution core and a randomised packer. TypeScript port of a master's thesis algorithm.",
  "keywords": [
    "bin-packing",
    "3d-bin-packing",
    "container-loading",
    "packing",
    "cargo",
    "logistics"
  ],
  "license": "Apache-2.0",
  "author": "Jānis Strautiņš (https://janisstrautins.lv)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strauteka/bin-packing.git"
  },
  "homepage": "https://github.com/Strauteka/bin-packing#readme",
  "bugs": "https://github.com/Strauteka/bin-packing/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
